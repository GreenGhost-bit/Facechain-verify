# Copy to .env and fill in only what you need. Everything here is OPTIONAL.
# Default search stack (serpapi,multiris,wikimedia,local) skips anything unavailable.
# Blockchain anchoring defaults to the local Merkle ledger (no secrets).

# ----------------------------------------------------------------------------
# Search providers
# ----------------------------------------------------------------------------
# SerpAPI: Google Lens reverse-image (returns real social-media posts).
# Free tier, no credit card: https://serpapi.com/
FACECHAIN_SERPAPI_KEY=

# SerpAPI Lens needs a PUBLIC url for the probe. Either pass --probe-image-url,
# or opt in here to upload the probe to a short-lived public file host
# (catbox/litterbox/tmpfiles). Off by default: this publishes the subject's face.
# FACECHAIN_ALLOW_PUBLIC_PROBE_HOST=1

# Default stack (override only if you need a smaller set):
# FACECHAIN_SEARCH_PROVIDERS=serpapi,multiris,wikimedia,local
#
# Multi-engine reverse image:  pip install -e ".[ris]"
# Plain search with defaults:
#   python -m facechain search PHOTO
#   python -m facechain run PHOTO --anchor local
#
# When reverse image misses (e.g. LinkedIn CDN), pass a name or profile URL:
#   python -m facechain search PHOTO --hint "https://www.linkedin.com/in/someone/"

# Google Cloud Vision "web detection" as an alternative reverse-image provider.
# Point at a service-account JSON with Vision API enabled.
GOOGLE_APPLICATION_CREDENTIALS=

# Contact string sent in the User-Agent for Wikimedia / web fetches (etiquette).
FACECHAIN_HTTP_CONTACT=facechain-verify (contact: you@example.com)

# Logging: every search/run also writes runs/<id>/run.log + telemetry.jsonl
# FACECHAIN_LOG_LEVEL=debug
# FACECHAIN_LOG_JSON=1

# Operator signature (facechain run --sign): path to a hex Ed25519 private key.
# Created automatically under chaindata/ if unset. Keep it secret.
# FACECHAIN_SIGNING_KEY=operator_ed25519.key

# Local caption model for `facechain describe` / `run --describe` ([describe] extra).
# FACECHAIN_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# ----------------------------------------------------------------------------
# Blockchain anchoring (only needed for --anchor evm)
# ----------------------------------------------------------------------------
# Any EVM JSON-RPC endpoint. Examples:
#   Sepolia:        https://ethereum-sepolia-rpc.publicnode.com
#   Polygon Amoy:   https://rpc-amoy.polygon.technology
FACECHAIN_EVM_RPC_URL=
# Funded testnet private key (0x-prefixed). NEVER use a mainnet key here.
FACECHAIN_EVM_PRIVATE_KEY=
# Optional: address of an already-deployed EvidenceRegistry contract.
# If unset, the EVM backend anchors via calldata of a 0-value self-transaction.
FACECHAIN_EVM_REGISTRY_ADDRESS=
FACECHAIN_EVM_CHAIN_ID=
